{
  "__inputs": [
    { "name": "DS_INFLUXDB", "label": "InfluxDB", "type": "datasource", "pluginId": "influxdb" }
  ],
  "__requires": [
    { "type": "grafana",   "id": "grafana",   "name": "Grafana",   "version": "10.0.0" },
    { "type": "datasource","id": "influxdb",  "name": "InfluxDB",  "version": "1.0.0"  },
    { "type": "panel",     "id": "timeseries","name": "Time series","version": "" },
    { "type": "panel",     "id": "stat",      "name": "Stat",      "version": "" },
    { "type": "panel",     "id": "heatmap",   "name": "Heatmap",   "version": "" }
  ],
  "title": "Occupancy Prediction",
  "uid":   "smarthome-occupancy",
  "tags":  ["smarthome", "occupancy", "tinyml"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Occupancy Probability — All Rooms",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"energy_telemetry\")\n  |> filter(fn: (r) => r._field == \"occupancy_prob\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color":  { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "min": 0, "max": 1, "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",  "value": null },
              { "color": "green", "value": 0.6 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend":  { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "title": "Currently Occupied",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"energy_telemetry\")\n  |> filter(fn: (r) => r._field == \"occupancy_prob\")\n  |> filter(fn: (r) => r._value >= 0.6)\n  |> distinct(column: \"device_id\")\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Occupied Rooms",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",  "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 3,
      "title": "Occupancy Heatmap (by Hour of Day)",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"energy_telemetry\")\n  |> filter(fn: (r) => r._field == \"occupancy_prob\")\n  |> aggregateWindow(every: 1h, fn: mean, createEmpty: false)"
        }
      ],
      "options": {
        "calculate": false,
        "color": { "scheme": "Oranges", "steps": 64 },
        "yAxis": { "unit": "percentunit" }
      }
    },
    {
      "id": 4,
      "title": "Motion Events (PIR) — Last 24h",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"energy_telemetry\")\n  |> filter(fn: (r) => r._field == \"motion\")\n  |> toFloat()\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "drawStyle": "bars"
          },
          "min": 0, "max": 1,
          "color": { "fixedColor": "orange", "mode": "fixed" }
        }
      }
    }
  ]
}
