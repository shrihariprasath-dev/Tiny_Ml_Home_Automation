{
  "title": "Smart Home Energy Dashboard",
  "uid": "smarthome-energy",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "gauge", "title": "Live Power (W)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "from(bucket:\"energy_telemetry\") |> range(start:-1m) |> filter(fn:(r)=>r._field==\"power_w\") |> last()"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizValue": 0, "maxVizValue": 5000 }
    },
    {
      "id": 2, "type": "timeseries", "title": "Power Consumption (W) — Last 6h",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 6 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "from(bucket:\"energy_telemetry\") |> range(start:v.timeRangeStart,stop:v.timeRangeStop) |> filter(fn:(r)=>r._field==\"power_w\") |> aggregateWindow(every:1m,fn:mean)"
      }]
    },
    {
      "id": 3, "type": "stat", "title": "Energy Today (kWh)",
      "gridPos": { "x": 0, "y": 6, "w": 4, "h": 4 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "from(bucket:\"energy_telemetry\") |> range(start:-24h) |> filter(fn:(r)=>r._field==\"energy_kwh\") |> difference() |> sum()"
      }]
    },
    {
      "id": 4, "type": "stat", "title": "Anomaly Score",
      "gridPos": { "x": 4, "y": 6, "w": 4, "h": 4 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "from(bucket:\"energy_telemetry\") |> range(start:-5m) |> filter(fn:(r)=>r._field==\"anomaly_score\") |> last()"
      }],
      "thresholds": { "steps": [
        {"color":"green","value":null},
        {"color":"yellow","value":0.3},
        {"color":"red","value":0.5}
      ]}
    },
    {
      "id": 5, "type": "stat", "title": "Occupancy Probability",
      "gridPos": { "x": 8, "y": 6, "w": 4, "h": 4 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "from(bucket:\"energy_telemetry\") |> range(start:-5m) |> filter(fn:(r)=>r._field==\"occupancy_prob\") |> last()"
      }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Temperature & Humidity",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 4 },
      "datasource": "InfluxDB",
      "targets": [
        { "query": "from(bucket:\"energy_telemetry\") |> range(start:v.timeRangeStart) |> filter(fn:(r)=>r._field==\"temperature\") |> aggregateWindow(every:5m,fn:mean)" },
        { "query": "from(bucket:\"energy_telemetry\") |> range(start:v.timeRangeStart) |> filter(fn:(r)=>r._field==\"humidity\") |> aggregateWindow(every:5m,fn:mean)" }
      ]
    }
  ]
}
