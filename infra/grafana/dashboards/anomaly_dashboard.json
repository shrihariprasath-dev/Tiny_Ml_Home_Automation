{
  "__inputs": [
    { "name": "DS_INFLUXDB", "label": "InfluxDB", "type": "datasource", "pluginId": "influxdb" }
  ],
  "__requires": [
    { "type": "grafana",   "id": "grafana",  "name": "Grafana",  "version": "10.0.0" },
    { "type": "datasource","id": "influxdb", "name": "InfluxDB", "version": "1.0.0"  },
    { "type": "panel",     "id": "timeseries","name": "Time series","version": "" },
    { "type": "panel",     "id": "gauge",    "name": "Gauge",    "version": "" },
    { "type": "panel",     "id": "table",    "name": "Table",    "version": "" }
  ],
  "title": "Anomaly Detection",
  "uid":   "smarthome-anomaly",
  "tags":  ["smarthome", "anomaly", "tinyml"],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Anomaly Score — All Devices",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"energy_telemetry\")\n  |> filter(fn: (r) => r._field == \"anomaly_score\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color":  { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "min": 0, "max": 1, "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red",    "value": 0.5 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend":  { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "title": "Current Anomaly Score",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"energy_telemetry\")\n  |> filter(fn: (r) => r._field == \"anomaly_score\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1, "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red",    "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Anomaly Events (Score > 0.5) — Last 7 Days",
      "type": "table",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"energy_telemetry\")\n  |> filter(fn: (r) => r._field == \"anomaly_score\")\n  |> filter(fn: (r) => r._value > 0.5)\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)"
        }
      ],
      "options": { "sortBy": [{ "displayName": "Time", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "displayMode": "color-background" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "_value" },
            "properties": [
              { "id": "displayName", "value": "Anomaly Score" },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "yellow", "value": null },
                    { "color": "red",    "value": 0.8 }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
