# ── Smart Home System — Environment Variables ─────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to git.

# ── FastAPI ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smarthome
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://smarthome:changeme@postgres:5432/smarthome

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=my-super-secret-influx-token
INFLUX_ORG=smarthome
INFLUX_BUCKET=energy_data

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USER=backend
MQTT_PASSWORD=changeme

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── AI Service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai_service:8001

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=change-me-to-another-random-string
NEXTAUTH_API_URL=http://api:8000

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
GF_SERVER_ROOT_URL=https://your-domain.com/grafana/

# ── OTA ───────────────────────────────────────────────────────────────────────
OTA_BASE_URL=https://your-domain.com/ota
